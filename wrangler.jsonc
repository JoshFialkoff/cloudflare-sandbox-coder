{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sandbox-router",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "name": "sandbox-router-sandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SandboxV2",
        "name": "SANDBOX"
      }
    ]
  },
  "exports": {
    "Sandbox": {
      "type": "durable-object",
    },
    "SandboxV2": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "sandbox-router-sandbox"
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "BWS_PROJECT_ID": "7afd61b4-a7cb-49f0-b215-b4bd0111966a",
    "GOOGLE_ADS_CUSTOMER_ID": "587-159-6696",
    "MAX_ITERATIONS": "25",
    "SANDBOX_ID_PREFIX": "llm-session",
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "BOT_KEYS": "{}",
    "BOT_SECRET_SCOPES": "{}"
  },
  "secrets": {
    "required": [
      "bitwarden_secret",
      "CLOUDFLARE_API_KEY",
      "CUSTOM_SMART_ROUTER_CLOUDFLARE_WORKERS_AI_API_KEY",
      "GOOGLE_ADS_CLIENT_ID",
      "GOOGLE_ADS_CLIENT_SECRET",
      "GOOGLE_ADS_DEVELOPER_TOKEN",
      "GOOGLE_ADS_REFRESH_TOKEN"
    ]
  }
}
